# 复制为仓库根目录的 .env，填写所测试服务的配置（.env 已被 Git 忽略）。
# 腾讯云长期密钥
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# 音色必须显式选择，可参考 TTSTencent.get_voices() 返回的数据。
TENCENT_TTS_VOICE_TYPE=1001
# 可选：不填写时使用一句简短的中文测试文本。
TENCENT_TTS_TEXT="你好，这是腾讯云语音合成本地测试。"

# Azure Speech：密钥及资源所在区域，例如 eastasia。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# 可选：zh 使用云健音色，en 使用 Andrew Multilingual 音色。
AZURE_TTS_LANGUAGE=zh
AZURE_TTS_TEXT="你好，这是 Azure 语音合成本地测试。"
